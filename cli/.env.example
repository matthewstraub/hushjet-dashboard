# Copy to .env and fill in. .env is gitignored.

# MyDyson account. A dedicated login added as a second user on the purifier
# keeps your main account out of this prototype.
DYSON_EMAIL=you@example.com
# Leave DYSON_PASSWORD unset to be prompted at login instead of storing it on disk.
# DYSON_PASSWORD=
DYSON_COUNTRY=US
# DYSON_CULTURE=en-US

# The purifier's LAN address. Optional: mDNS finds it otherwise, but a DHCP
# reservation plus this setting avoids most discovery failures.
# DYSON_HOST=192.168.1.40
# DYSON_PORT=1883

# Only needed when the account has more than one device.
# DYSON_SERIAL=XXX-XX-XXXXXXXX

# How often to ask for sensor data, in seconds (the app and Home Assistant use 30).
# DYSON_POLL_SECONDS=30

# The App API wants a mobile-app User-Agent. libdyson-neon and the community spec
# use "android client"; libdyson-rest uses "DysonLink/205298 Darwin/27.0.0".
# DYSON_USER_AGENT=android client

# Where the token and device credentials go (owner-only files, outside the repo)
# and where readings and raw captures go.
# HUSHJET_STATE_DIR=~/.config/hushjet
# HUSHJET_DATA_DIR=data
