# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit real values; .env itself is gitignored.

# TiDB Cloud or any MySQL. Leave empty to run without a database: live
# readings still work, and history waits. TiDB needs the ssl suffix, e.g.
#   mysql://user:pass@host:4000/hushjet?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Site sign-in. With VIEWER_PASSWORD empty, development skips sign-in and
# treats everyone as admin. Production requires VIEWER_PASSWORD and SESSION_SECRET.
VIEWER_PASSWORD=
# Optional: a second, different password that unlocks the Controls tab and adding notes.
ADMIN_PASSWORD=
# A long random value, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# Dyson. Locally, leave DYSON_TOKEN empty: the dashboard and `pnpm sync` use
# the token that `hushjet login` (in cli/) saved. Render and GitHub get that
# same token as a secret.
DYSON_TOKEN=
# Only needed when the account has more than one HushJet.
# DYSON_SERIAL=
# DYSON_COUNTRY=US
# Where `hushjet login` keeps its token, if not ~/.config/hushjet.
# HUSHJET_STATE_DIR=

# Server port (optional, defaults to 3000)
# PORT=
